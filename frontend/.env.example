# Public build configuration only. All values are placeholders.
# Generate confirmed testnet values with npm run env:testnet.
NEXT_PUBLIC_AME_NETWORK=
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=
NEXT_PUBLIC_AME_AGENT_ADDRESS=
NEXT_PUBLIC_AME_AGENT_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_AME_RECEIPT_ADDRESS=
NEXT_PUBLIC_AME_RECEIPT_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_AME_LENDING_ADDRESS=
NEXT_PUBLIC_AME_LENDING_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_AME_TEST_FAUCET=
# Local development configuration is generated by the sync commands.
# Never copy a deployer key or private RPC credential here.

# Server-only holder access. Leave ALL three unset until the real $AME launch.
# Threshold is a positive token amount in human units, not atomic units.
AME_TOKEN_ADDRESS=
AME_HOLDER_THRESHOLD=
AME_TOKEN_CHAIN_ID=
# Optional official HTTPS acquisition URL; hidden when absent or before launch.
AME_TOKEN_URL=
# Required for an unlisted chain, optional RPC override for supported chains.
# Server only: never prefix these variables with NEXT_PUBLIC_.
AME_TOKEN_RPC_URL=
