# Public build configuration only. All values are placeholders.
# Generate confirmed testnet values with npm run env:testnet.
NEXT_PUBLIC_AME_NETWORK=
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=
NEXT_PUBLIC_AME_AGENT_ADDRESS=
NEXT_PUBLIC_AME_AGENT_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_AME_RECEIPT_ADDRESS=
NEXT_PUBLIC_AME_RECEIPT_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_AME_LENDING_ADDRESS=
NEXT_PUBLIC_AME_LENDING_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_AME_TEST_FAUCET=
# Local development configuration is generated by the sync commands.
# Never copy a deployer key or private RPC credential here.

# Server-only holder access. Leave ALL three unset until the real $AME launch.
# Threshold is a positive token amount in human units, not atomic units.
AME_TOKEN_ADDRESS=
AME_HOLDER_THRESHOLD=
AME_TOKEN_CHAIN_ID=
# Optional official HTTPS acquisition URL; hidden when absent or before launch.
AME_TOKEN_URL=
# Required for an unlisted chain, optional RPC override for supported chains.
# Server only: never prefix these variables with NEXT_PUBLIC_.
AME_TOKEN_RPC_URL=
# Token reads require independently approved values AND explicit verification.
# No value below activates mainnet lending signing or supplies a holder threshold.
AME_TOKEN_VERIFIED=
AME_TOKEN_RUNTIME_HASH=
AME_TOKEN_DECIMALS=
AME_TOKEN_SYMBOL=
# Maximum approved totalSupply in atomic units; immutable launch review input.
AME_TOKEN_MAX_SUPPLY=
AME_TOKEN_DEPLOYMENT_BLOCK=
# Optional comma-separated HTTPS fallback RPCs, at most two; server-only credentials.
AME_TOKEN_RPC_FALLBACK_URLS=
# Optional reviewed spender for read-only allowance inspection, never an approval request.
AME_TOKEN_ALLOWANCE_SPENDER=

# Identity is independent from legacy testnet lending above.
# Production identity always targets Robinhood Mainnet (4663).
# Leave unset until an actual deployment is confirmed and runtime-verified.
NEXT_PUBLIC_AME_MAINNET_AGENT_ADDRESS=
NEXT_PUBLIC_AME_MAINNET_AGENT_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_AME_MAINNET_RECEIPT_ADDRESS=
NEXT_PUBLIC_AME_MAINNET_RECEIPT_DEPLOYMENT_BLOCK=
# Development only: localhost, testnet or mainnet (production ignores this override).
NEXT_PUBLIC_AME_IDENTITY_NETWORK=

# Tasks V1: server-only durable storage. Keep writes disabled until approved
# storage integration, real Redis concurrency tests and explicit release approval.
AME_TASKS_WRITES_ENABLED=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative Redis REST credentials, if the KV names above are not used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
